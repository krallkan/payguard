# Demo mode: fixtures + in-memory contract simulator + fake LLM. No keys or funds needed.
DEMO=1

# --- Testnet mode (DEMO=0) ---
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEARBLOCKS_API_URL=https://api-testnet.nearblocks.io
GUARD_CONTRACT_ID=
OWNER_ACCOUNT_ID=
# Full-access key of the owner (human). Used only by deploy/admin scripts, never by the agent.
OWNER_PRIVATE_KEY=
# Owner console (web UI / npm run owner): function-call key on the owner account, limited to
# approve_pending, reject_pending, report, set_frozen on the guard.
OWNER_CONSOLE_KEY=
AGENT_ACCOUNT_ID=
# Demo receivers: a normal shop and a known-bad address for the attack demo.
SHOP_ACCOUNT_ID=
BAD_ACCOUNT_ID=
# A fresh, never-paid vendor: shows the warn → owner approval flow.
NEWVENDOR_ACCOUNT_ID=
# Function-call access key of the agent (scoped to GUARD_CONTRACT_ID). Never a full-access key.
AGENT_PRIVATE_KEY=
# ed25519 key the risk service uses to sign verdicts (`npm run keygen:oracle`).
ORACLE_PRIVATE_KEY=
ORACLE_PUBLIC_KEY=

# Optional: NEAR AI Cloud (OpenAI-compatible). Empty = scripted fake LLM.
NEAR_AI_API_KEY=
